# --- Procore app credentials (from developers.procore.com > your app > OAuth) ---
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on your Procore app.
PROCORE_REDIRECT_URI=http://localhost:4000/auth/procore/callback

# Procore environment base URLs.
# Production:
PROCORE_OAUTH_BASE=https://login.procore.com
PROCORE_API_BASE=https://api.procore.com
# Sandbox (verify current sandbox hostnames in the Procore Developer Portal —
# they've changed before, and this repo's values may drift out of date):
# PROCORE_OAUTH_BASE=https://login-sandbox.procore.com
# PROCORE_API_BASE=https://sandbox.procore.com

# The Procore project you want revisions/schedule packets for.
PROCORE_PROJECT_ID=88213
PROCORE_COMPANY_ID=

# Shared secret you choose yourself. Enter this EXACT value in the
# "Authorization Header" field when you create the Hook in Procore
# (Project Admin > Webhooks > Create Hook). Procore echoes it back on every
# webhook POST so you can verify the request actually came from your hook.
PROCORE_WEBHOOK_SECRET=change-me-to-something-long-and-random

# Port this server listens on.
PORT=4000

# Comma-separated list of origins allowed to call GET /api/packets
# (put your deployed OhmBoy frontend URL here).
ALLOWED_ORIGINS=http://localhost:3000
