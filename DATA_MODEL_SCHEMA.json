{
  "version": "0.18",
  "purpose": "Rigid integrated project-control data model for OhmBoy.",
  "core_objects": {
    "Project": [
      "id",
      "name",
      "originalContractValue",
      "approvedCOValue",
      "pendingCOValue",
      "costToDate",
      "forecastCostToComplete",
      "contingencyRemaining"
    ],
    "SOVLine": [
      "id",
      "description",
      "contractValue",
      "billedToDate",
      "percentComplete",
      "phaseCodes",
      "linkedPackets",
      "linkedCOs",
      "linkedRisks"
    ],
    "PhaseCode": [
      "id",
      "name",
      "budget",
      "costToDate",
      "forecast",
      "sov",
      "linkedScheduleActivities",
      "linkedProcurement"
    ],
    "Packet": [
      "id",
      "type",
      "title",
      "status",
      "score",
      "scoreBreakdown",
      "phaseCode",
      "sovLine",
      "linkedBranches",
      "linkedFinancials"
    ],
    "RFI": [
      "id",
      "status",
      "ballInCourt",
      "daysOpen",
      "responseDue",
      "linkedPacket",
      "linkedCO",
      "phaseCode",
      "sovLine",
      "costImpact",
      "scheduleImpact"
    ],
    "ChangeOrder": [
      "id",
      "status",
      "romValue",
      "submittedValue",
      "approvedValue",
      "phaseCode",
      "sovLine",
      "linkedPacket",
      "linkedRFI",
      "linkedRisk"
    ],
    "ProcurementItem": [
      "id",
      "item",
      "vendor",
      "specSection",
      "releaseDate",
      "requiredOnSite",
      "eta",
      "floatDays",
      "phaseCode",
      "sovLine",
      "linkedScheduleActivity",
      "linkedRisk"
    ],
    "Risk": [
      "id",
      "title",
      "category",
      "probability",
      "impact",
      "score",
      "owner",
      "watchDate",
      "triggerDate",
      "mitigation",
      "financialExposure",
      "scheduleExposureDays",
      "linkedItems"
    ],
    "FinancialSnapshot": [
      "id",
      "date",
      "contractValue",
      "costToDate",
      "forecastToComplete",
      "eac",
      "leftToSpend",
      "projectedGainFade",
      "riskAdjustedEAC"
    ],
    "OpenPO": [
      "id",
      "vendor",
      "description",
      "status",
      "phaseCode",
      "sov",
      "committed",
      "invoiced",
      "remaining",
      "forecastAtCompletion",
      "riskExposure",
      "requiredOnSite",
      "eta",
      "linked"
    ],
    "BillingAgingItem": [
      "id",
      "type",
      "sov",
      "description",
      "amount",
      "billedDate",
      "termDays",
      "dueDate",
      "agingBucket",
      "paid",
      "status"
    ],
    "FinancialSourceMap": [
      "contractSource",
      "openPOSource",
      "agingSource",
      "changeOrderSource",
      "riskSource",
      "eacSource",
      "colorCode"
    ]
  },
  "rules": [
    "Every financial record must map to a phase code and SOV line.",
    "Every risk must include probability, impact, owner, mitigation, watch date, trigger date, and linked items.",
    "Every packet must be linkable to the objects it affects.",
    "All objects must be searchable by ID, status, owner, phase code, SOV line, vendor, schedule activity, and keyword.",
    "Audit log records create/update/status changes.",
    "High-level financial summary numbers must identify the report/source they came from and carry matching color-code references.",
    "Open PO remaining must flow into left-to-spend and PO forecast must be considered in EAC review.",
    "Billed and forecast billing records must be aged by payment terms and tied back to SOV lines."
  ]
}