# OhmBoy — Procore environment variables (PRODUCTION - your real company)
#
# Fill in the four CHANGE-ME values, then either:
#   A) Netlify > Site settings > Environment variables > Add a variable
#      > Import from a .env file  -- paste this whole thing, or
#   B) add them one at a time with the form.
#
# Either way: Scopes = All scopes, Values = Same value for all deploy contexts.
# Mark PROCORE_CLIENT_SECRET and PROCORE_WEBHOOK_SECRET as secret values.
#
# No quotes around values. No spaces around the = sign.
# REDEPLOY after saving -- Netlify only reads these on a fresh deploy.


# --- From your Procore app, PRODUCTION OAuth Credentials section ---
PROCORE_CLIENT_ID=CHANGE-ME-PRODUCTION-client-id
# NOTE: the production secret is shown exactly ONCE, in the popup at
# Promote Version. If you lost it, reset it in OAuth Credentials.
PROCORE_CLIENT_SECRET=CHANGE-ME-PRODUCTION-client-secret

# --- Must match the Redirect URI registered in Procore, character for character.
#     Replace YOUR-SITE with your actual Netlify site name.
#     The OhmBoy Procore Link page shows this exact string with a Copy button. ---
PROCORE_REDIRECT_URI=https://YOUR-SITE.netlify.app/.netlify/functions/procore-auth-callback

# --- Development Sandbox hosts. These two are different from each other on
#     purpose: login-sandbox is the auth host, sandbox is the API host.
#     Do not mix these with sandbox credentials - tokens are not interchangeable. ---
PROCORE_OAUTH_BASE=https://login.procore.com
PROCORE_API_BASE=https://api.procore.com

# --- You invent this one. Nobody issues it. It is the shared password Procore
#     echoes back on every webhook so OhmBoy can tell a real delivery from a
#     forged one. 30+ random characters. Do not reuse a password you use
#     anywhere else. ---
PROCORE_WEBHOOK_SECRET=CHANGE-ME-a-DIFFERENT-long-random-string

# --- Identifies OhmBoy's hooks in Procore. Leave as-is. ---
PROCORE_WEBHOOK_NAMESPACE=ohmboy-packets


# --- Add this LAST, after you have authorised. ---
# Procore does not tell you the company id until after the OAuth callback,
# so it cannot go in on this first pass. Come back, add it, and redeploy again.
#
# PROCORE_COMPANY_ID=
